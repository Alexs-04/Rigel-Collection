# Copy to .env (never commit it) and adjust. Read by docker compose.

# --- Required -----------------------------------------------------------------
# Password of the PostgreSQL user created on first start.
DB_PASSWORD=change-me
# Base64 HMAC key of at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=

# --- Ports published on the host ----------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8080

# --- Access -------------------------------------------------------------------
# Public URL of the frontend (CORS origin and base of the links sent by email).
# To share the app on the LAN, use this machine's address, e.g. http://192.168.0.10:5173
ORIGIN=http://localhost:5173
# Let browsers on the local network call the backend port directly (frontend running elsewhere).
CORS_LOCAL_NETWORK=false
CORS_LOCAL_NETWORK_PATTERNS=http://192.168.0.*:[*]

# --- Optional -----------------------------------------------------------------
DB_NAME=rigel_db
DB_USERNAME=rigel_root

# Email: leave empty to run without it (links are written to the backend log).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Cloudinary: leave empty to store product images in the "uploads" volume.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
